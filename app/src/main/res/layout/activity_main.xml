<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:id="@+id/rootView"
    tools:context=".MainActivity">

    <!-- App Background Image -->
    <ImageView
        android:id="@+id/ivBackground"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:src="@drawable/background"
        android:scaleType="centerCrop"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Semitransparent overlay to ensure maximum text readability -->
    <View
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="#40000000"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Content Wrapper to center things in portrait/landscape nicely -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:weightSum="10"
        android:padding="24dp">

        <!-- Top spacing/Logo or empty space (3/10) -->
        <View
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <!-- Album Artwork Container (above the DJ decks) -->
        <androidx.cardview.widget.CardView
            android:id="@+id/cvArtwork"
            android:layout_width="180dp"
            android:layout_height="180dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="8dp"
            app:cardBackgroundColor="@color/black"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="16dp">

            <ImageView
                android:id="@+id/ivArtwork"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                android:src="@mipmap/ic_launcher_round" />
        </androidx.cardview.widget.CardView>

        <!-- Dynamic Now Playing Text (above the DJ decks) -->
        <TextView
            android:id="@+id/tvNowPlayingLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="NOW PLAYING"
            android:textColor="@color/white_translucent"
            android:textSize="14sp"
            android:textStyle="bold"
            android:letterSpacing="0.1"
            android:shadowColor="@color/text_shadow_color"
            android:shadowDx="2"
            android:shadowDy="2"
            android:shadowRadius="3"
            android:layout_marginBottom="4dp" />

        <TextView
            android:id="@+id/tvTrackTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="DRA'man - Sweet Havana Transvestite"
            android:textColor="@color/white"
            android:textSize="20sp"
            android:textStyle="bold"
            android:gravity="center"
            android:shadowColor="@color/text_shadow_color"
            android:shadowDx="2"
            android:shadowDy="2"
            android:shadowRadius="4"
            android:layout_marginLeft="16dp"
            android:layout_marginRight="16dp"
            android:layout_marginBottom="16dp" />

        <!-- Dynamic Next Playing Text -->
        <TextView
            android:id="@+id/tvNextTrackLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="COMING NEXT"
            android:textColor="@color/white_translucent"
            android:textSize="14sp"
            android:textStyle="bold"
            android:letterSpacing="0.1"
            android:shadowColor="@color/text_shadow_color"
            android:shadowDx="2"
            android:shadowDy="2"
            android:shadowRadius="3"
            android:layout_marginBottom="4dp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/tvNextTrack"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text=""
            android:textColor="@color/white"
            android:textSize="16sp"
            android:gravity="center"
            android:shadowColor="@color/text_shadow_color"
            android:shadowDx="2"
            android:shadowDy="2"
            android:shadowRadius="4"
            android:layout_marginLeft="16dp"
            android:layout_marginRight="16dp"
            android:layout_marginBottom="24dp"
            android:visibility="gone" />

        <!-- Spacer to push the control buttons on top of or below decks -->
        <View
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="3" />

        <!-- Buttons Container (White icons, custom-designed buttons) -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:background="@android:color/transparent"
            android:paddingHorizontal="24dp"
            android:paddingVertical="12dp"
            android:layout_marginBottom="16dp">

            <!-- Mute/Unmute Button -->
            <ImageButton
                android:id="@+id/btnMute"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:src="@drawable/ic_volume_up_white_24dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:contentDescription="Mute Audio"
                android:scaleType="fitCenter"
                android:layout_marginRight="24dp" />

            <!-- Play/Pause Button -->
            <ImageButton
                android:id="@+id/btnPlayPause"
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:src="@drawable/ic_pause_white_24dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:contentDescription="Play/Pause"
                android:scaleType="fitCenter"
                android:layout_marginRight="24dp" />

            <!-- Cast/Bluetooth Button -->
            <androidx.mediarouter.app.MediaRouteButton
                android:id="@+id/mediaRouteButton"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                app:mediaRouteButtonTint="@color/white"
                android:contentDescription="Cast" />

        </LinearLayout>

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
